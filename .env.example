# --- Supabase Postgres -------------------------------------------------
# From Supabase: Project Settings -> Database -> Connection string
#
# DATABASE_URL = the "Transaction pooler" string (port 6543) - used by the
#   app at runtime. Add "&pgbouncer=true&connection_limit=1" so Prisma plays
#   well with serverless functions on Vercel.
# DIRECT_URL   = the "Direct connection" string (port 5432) - used only for
#   running Prisma migrations.
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Long random string used to sign login session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-this-with-a-long-random-string"
